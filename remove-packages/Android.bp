android_app_import {
    name: "RemovePackages",
    apk: "DebloatDummy.apk",
    presigned: true,
    preprocessed: true,

    overrides: [
        "CalculatorGooglePrebuilt",
        "CalendarGooglePrebuilt",
        "Chrome-Stub",
        "talkback",
        "YouTube",
        "Drive",
        "Symphonica",
    ],
	dex_preopt: {
		enabled: false,
	},
	privileged: true,
}